"""Task 1: visualise Rosenbrock's function in 2D and 3D."""
import numpy as np
import matplotlib.pyplot as plt
from matplotlib.colors import LogNorm


def rosenbrock(x, y):
    """f(x, y) = 100 (y - x^2)^2 + (1 - x)^2, minimum at (1, 1)."""
    return 100.0 * (y - x**2) ** 2 + (1.0 - x) ** 2


# 1. Sample the function uniformly on a grid over [-2, 2] x [-2, 2]
n = 400
xs = np.linspace(-2.0, 2.0, n)
ys = np.linspace(-2.0, 2.0, n)
X, Y = np.meshgrid(xs, ys)          # X[i, j] = xs[j], Y[i, j] = ys[i]
Z = rosenbrock(X, Y)

x_min, y_min = 1.0, 1.0

# 2. 3D surface plot
fig = plt.figure(figsize=(7, 6))
ax = fig.add_subplot(111, projection="3d")
ax.computed_zorder = False          # draw in the order given, so the marker sits on top
ax.plot_surface(X, Y, Z, cmap="viridis", rstride=5, cstride=5,
                linewidth=0, antialiased=True, alpha=0.9)
ax.plot([x_min], [y_min], [rosenbrock(x_min, y_min)], "r*",
        markersize=14, label="minimum (1, 1)")
ax.view_init(elev=35, azim=-130)   # rotate so the valley floor is visible
ax.set_xlabel("x")
ax.set_ylabel("y")
ax.set_zlabel("f(x, y)")
ax.set_title("Rosenbrock's function (3D)")
ax.legend()
fig.tight_layout()
fig.savefig("task1_rosenbrock_3d.png", dpi=150)

# 3. 2D contour plot. The function spans 0 to ~3600 on this box, so a
#    logarithmic colour scale is needed to see the banana-shaped valley.
fig, ax = plt.subplots(figsize=(7, 6))
levels = np.logspace(-2, 3.6, 30)
cf = ax.contourf(X, Y, Z, levels=levels, norm=LogNorm(), cmap="viridis",
                 extend="both")   # colour values outside the level range too
ax.contour(X, Y, Z, levels=levels, norm=LogNorm(),
           colors="black", linewidths=0.3)
fig.colorbar(cf, ax=ax, label="f(x, y) (log scale)",
             ticks=[1e-2, 1e-1, 1, 10, 100, 1000])
ax.plot(x_min, y_min, "r*", markersize=15, label="minimum (1, 1)")
ax.set_xlabel("x")
ax.set_ylabel("y")
ax.set_title("Rosenbrock's function (2D contours)")
ax.set_aspect("equal")
ax.legend(loc="upper left")
fig.tight_layout()
fig.savefig("task1_rosenbrock_2d.png", dpi=150)

plt.show()